{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterWX",
  "version": "2.2.0",
  "identifier": "io.github.shusfun.betterwx",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:15731",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["../logo.ico", "../logo.png"] }
}
